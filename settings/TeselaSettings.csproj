<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ventana de ajustes de Tesela en WinUI 3 (Windows App SDK): controles y texto de Windows 11, como TranslucentTB -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TeselaSettings</RootNamespace>
    <AssemblyName>TeselaSettings</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Tesela</Product>
    <Company>IvannPerezz</Company>
    <Copyright>© 2026 IvannPerezz</Copyright>
    <AssemblyTitle>Tesela — Ajustes</AssemblyTitle>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <Nullable>disable</Nullable>
    <SatelliteResourceLanguages>es;en</SatelliteResourceLanguages>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Tesela.ico</ApplicationIcon>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup>
    <!-- Solo las piezas de Windows App SDK que usa la ventana (sin IA, ML ni widgets del sistema, que
         el paquete completo arrastra y suman unos 60 MB) -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="1.8.251216001" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="1.8.260803002" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="1.8.260708001" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="1.8.25122902" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Fonts\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Tesela.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\TeselaTiles.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
